{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "funtrack-standalone",
  "main": "./worker/standalone.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:8787",
    "CLERK_PUBLISHABLE_KEY": "",
    "WECHAT_LOGIN_ENABLED": "0",
    "FUNTRACK_AUTO_COVER_ENABLED": "0"
  },
  "secrets": {
    "required": [
      "CLERK_SECRET_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "funtrack-standalone-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle",
      "migrations_table": "d1_migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "funtrack-standalone-local"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  }
}
